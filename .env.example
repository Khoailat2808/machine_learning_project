# Copy thành .env rồi sửa nếu cần. KHÔNG commit file .env.
DJANGO_SECRET_KEY=change-me-for-local-dev
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Đường dẫn dữ liệu và model
DATASET_PATH=ml_engine/data/raw/ecommerce_customer_dataset.csv
ARTIFACT_DIR=ml_engine/artifacts

# Tài khoản demo do scripts/seed_db.py tạo (chỉ dùng local)
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123
DEMO_MARKETER_USERNAME=marketer
DEMO_MARKETER_PASSWORD=demo123

# Tham số CLV mặc định (Admin đổi được trên giao diện)
CLV_GROSS_MARGIN=0.33
CLV_DISCOUNT_RATE=0.10
CLV_HORIZON_YEARS=3
